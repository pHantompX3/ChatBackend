# Copy this file to scripts/config/local.secrets.env and fill in your real values.
# This file is safe to commit. The real local.secrets.env is gitignored.

# Required for all DB bootstrap/migration scripts
MSSQL_SA_PASSWORD=replace_with_sa_password

# App login used by Flyway placeholders (optional overrides)
WL_CHAT_DB_USERNAME=wl_chat_app
WL_CHAT_DB_PASSWORD=replace_with_app_password
WL_CHAT_MIGRATOR_USERNAME=messenger_migrator
WL_CHAT_MIGRATOR_PASSWORD=replace_with_migrator_password
WL_CHAT_BACKUP_USERNAME=wl_chat_backup
WL_CHAT_BACKUP_PASSWORD=replace_with_backup_password
WL_CHAT_RESTORE_USERNAME=wl_chat_restore
WL_CHAT_RESTORE_PASSWORD=replace_with_restore_password
WL_CHAT_BACKUP_MASTER_KEY_PASSWORD=replace_with_backup_master_key_password
WL_CHAT_BACKUP_CERTIFICATE_PASSWORD=replace_with_backup_certificate_password

# Local DB target (optional overrides)
WL_CHAT_DB_NAME=wl_chat
WL_CHAT_DB_PORT=1433
WL_CHAT_SQL_CONTAINER_NAME=local_sql_server

# DevDocker app host ports (optional overrides)
WL_CHAT_APP_PORT=8081
WL_CHAT_ENABLE_QUEUE=true

# Shared queue server (RabbitMQ) for one or more app instances
WL_CHAT_QUEUE_USERNAME=wl_chat_queue
WL_CHAT_QUEUE_PASSWORD=replace_with_queue_password
WL_CHAT_QUEUE_VHOST=/
WL_CHAT_QUEUE_PORT=5672
WL_CHAT_QUEUE_MGMT_PORT=15672
# 0.0.0.0 exposes queue to other machines that can reach this host
WL_CHAT_QUEUE_HOST_IP=0.0.0.0
# Keep management UI local-only by default; set to 0.0.0.0 to expose remotely
WL_CHAT_QUEUE_MGMT_HOST_IP=127.0.0.1
# Optional: override queue compose file path
# WL_CHAT_QUEUE_COMPOSE_FILE=/absolute/path/to/compose.queue.yaml

# Audit transport over RabbitMQ (app-side)
WL_CHAT_AUDIT_RABBITMQ_ENABLED=true
# Primary host used when host-candidates is unset.
WL_CHAT_AUDIT_RABBITMQ_HOST=127.0.0.1
# Optional ordered fallback hosts to support multiple runtime topologies.
WL_CHAT_AUDIT_RABBITMQ_HOST_CANDIDATES=queue-dev,127.0.0.1,host.docker.internal
WL_CHAT_AUDIT_RABBITMQ_PORT=5672
WL_CHAT_AUDIT_RABBITMQ_USERNAME=wl_chat_queue
WL_CHAT_AUDIT_RABBITMQ_PASSWORD=replace_with_queue_password
WL_CHAT_AUDIT_RABBITMQ_VHOST=/
WL_CHAT_AUDIT_RABBITMQ_EXCHANGE=audit.events
WL_CHAT_AUDIT_RABBITMQ_ROUTING_KEY=audit.completed
WL_CHAT_AUDIT_RABBITMQ_QUEUE=audit.events
WL_CHAT_AUDIT_RABBITMQ_CONSUMER_ENABLED=true
