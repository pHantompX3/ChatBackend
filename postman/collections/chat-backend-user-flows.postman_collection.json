{
  "info": {
    "name": "WL-Chat User Flow Runner",
    "description": "Flow-oriented Postman collection for repeatable integration scenarios. Use these requests in order to exercise a complete user journey against the local backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Identity onboarding happy path",
      "description": "Bootstrap an admin, create an invitation, and redeem it for a new member.",
      "item": [
        {
          "name": "01 - Bootstrap admin",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('bootstrap_admin_username', 'flow-admin-' + Date.now());",
                  "pm.environment.set('bootstrap_admin_password', pm.environment.get('bootstrap_admin_password') || 'AdminPassw0rd!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('admin_user_id', jsonData.userId);",
                  "pm.environment.set('admin_username', jsonData.username);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{bootstrap_admin_username}}\",\n  \"password\": \"{{bootstrap_admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bootstrap/admin",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "bootstrap", "admin"]
            }
          }
        },
        {
          "name": "02 - Create invitation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('invitation_expires_at', new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('invitation_id', jsonData.invitationId);",
                  "pm.environment.set('invitation_token', jsonData.invitationToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actorUserId\": \"{{admin_user_id}}\",\n  \"expiresAt\": \"{{invitation_expires_at}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/invitations",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "invitations"]
            }
          }
        },
        {
          "name": "03 - Redeem invitation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('member_username', 'member-' + Date.now());",
                  "pm.environment.set('member_password', pm.environment.get('member_password') || 'MemberPassw0rd!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('member_user_id', jsonData.userId);",
                  "pm.environment.set('member_username', jsonData.username);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invitationToken\": \"{{invitation_token}}\",\n  \"username\": \"{{member_username}}\",\n  \"password\": \"{{member_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/invitations/redeem",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "invitations", "redeem"]
            }
          }
        }
      ]
    },
    {
      "name": "Post-bootstrap invitation follow-up",
      "description": "Run after bootstrap is complete to create and revoke a second invitation using the bootstrapped admin identity.",
      "item": [
        {
          "name": "01 - Create follow-up invitation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('followup_invitation_expires_at', new Date(Date.now() + 12 * 60 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('followup_invitation_id', jsonData.invitationId);",
                  "pm.environment.set('followup_invitation_token', jsonData.invitationToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actorUserId\": \"{{admin_user_id}}\",\n  \"expiresAt\": \"{{followup_invitation_expires_at}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/invitations",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "invitations"]
            }
          }
        },
        {
          "name": "02 - Revoke follow-up invitation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actorUserId\": \"{{admin_user_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/invitations/{{followup_invitation_id}}/revoke",
              "host": ["{{base_url}}"],
              "path": [
                "api",
                "v1",
                "invitations",
                "{{followup_invitation_id}}",
                "revoke"
              ]
            }
          }
        }
      ]
    }
  ]
}
