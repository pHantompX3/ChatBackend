          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('bootstrap_admin_username', pm.environment.get('bootstrap_admin_username') || pm.environment.get('admin_username') || pm.environment.get('auth_username') || ('runall-admin-' + Date.now()));",
                  "pm.environment.set('bootstrap_admin_password', pm.environment.get('bootstrap_admin_password') || pm.environment.get('admin_password') || pm.environment.get('auth_password') || pm.globals.get('WLAdminPass') || 'AdminPassw0rd!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 409', function () {",
