          "name": "02 - Create follow-up invitation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var followupInvitationTtlHours = Number(pm.globals.get('WLFollowupInvitationTtlHours') || 12);\npm.environment.set('followup_invitation_expires_at', new Date(Date.now() + followupInvitationTtlHours * 60 * 60 * 1000).toISOString());",
                  "pm.environment.set('admin_user_id', pm.environment.get('admin_user_id') || '00000000-0000-0000-0000-000000000000');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('followup_invitation_id', jsonData.invitationId);",
                  "pm.environment.set('followup_invitation_token', jsonData.invitationToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{admin_bearer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actorUserId\": \"{{admin_user_id}}\",\n  \"expiresAt\": \"{{followup_invitation_expires_at}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/invitations",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "invitations"]
            }
          }
        },
        {
          "name": "03 - Revoke follow-up invitation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
