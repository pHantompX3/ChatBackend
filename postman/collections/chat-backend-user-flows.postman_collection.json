{
  "info": {
    "name": "WL-Chat User Flow Runner",
    "description": "Flow-oriented Postman collection for repeatable integration scenarios. Use these requests in order to exercise a complete user journey against the local backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Identity onboarding happy path",
      "description": "Bootstrap an admin, create an invitation, and redeem it for a new member.",
      "item": [
        {
          "name": "01 - Bootstrap admin",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('bootstrap_admin_username', 'flow-admin-' + Date.now());",
                  "pm.environment.set('bootstrap_admin_password', pm.environment.get('bootstrap_admin_password') || 'AdminPassw0rd!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('admin_user_id', jsonData.userId);",
                  "pm.environment.set('admin_username', jsonData.username);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{bootstrap_admin_username}}\",\n  \"password\": \"{{bootstrap_admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bootstrap/admin",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "bootstrap", "admin"]
            }
          }
        },
        {
          "name": "02 - Login bootstrap admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
