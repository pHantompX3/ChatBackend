  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function hasUsableEnvValue(key) {",
          "  var raw = pm.environment.get(key);",
          "  if (raw === undefined || raw === null) return false;",
          "  var s = String(raw).trim();",
          "  if (!s) return false;",
          "  if (s.startsWith('{{') && s.endsWith('}}')) return false;",
          "  var resolved = pm.variables.replaceIn(s).trim();",
          "  return !!resolved && !(resolved.startsWith('{{') && resolved.endsWith('}}'));",
          "}",
          "",
          "var mappings = [",
          "  { env: 'bootstrap_admin_username', globals: ['WLAdminUser_Local', 'WLAdminUser_Dev', 'WLAdminUser_Prod', 'WLAdminUser'] },",
          "  { env: 'bootstrap_admin_password', globals: ['WLAdminPass_Local', 'WLAdminPass_Dev', 'WLAdminPass_Prod', 'WLAdminPass'] },",
          "  { env: 'member_username', globals: ['WLMemberUser_Local', 'WLMemberUser_Dev', 'WLMemberUser_Prod', 'WLMemberUser'] },",
          "  { env: 'member_password', globals: ['WLMemberPass_Local', 'WLMemberPass_Dev', 'WLMemberPass_Prod', 'WLMemberPass'] },",
          "  { env: 'auth_username', globals: ['WLAuthUser_Local', 'WLAuthUser_Dev', 'WLAuthUser_Prod'] },",
          "  { env: 'auth_password', globals: ['WLAuthPass_Local', 'WLAuthPass_Dev', 'WLAuthPass_Prod'] },",
          "  { env: 'admin_user_id', globals: ['WLActorUserId_Local', 'WLActorUserId_Dev', 'WLActorUserId_Prod', 'WLActorUserId'] },",
          "  { env: 'conversation_id', globals: ['WLConversationId_Local', 'WLConversationId_Dev', 'WLConversationId_Prod', 'WLConversationIdDefault'] },",
          "  { env: 'sender_user_id', globals: ['WLSenderUserId_Local', 'WLSenderUserId_Dev', 'WLSenderUserId_Prod', 'WLSenderUserIdDefault'] },",
          "  { env: 'message_limit', globals: ['WLMessageLimit_Local', 'WLMessageLimit_Dev', 'WLMessageLimit_Prod', 'WLMessageLimitDefault'] }",
          "];",
          "",
          "mappings.forEach(function (entry) {",
          "  if (hasUsableEnvValue(entry.env)) return;",
          "  for (var i = 0; i < entry.globals.length; i += 1) {",
          "    var g = pm.globals.get(entry.globals[i]);",
          "    if (g !== undefined && g !== null && String(g).trim() !== '') {",
          "      pm.environment.set(entry.env, g);",
          "      return;",
          "    }",
          "  }",
          "});"
        ]
      }
    }
  ]
}
