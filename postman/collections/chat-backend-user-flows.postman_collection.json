              "host": ["{{base_url}}"],
              "path": [
                "api",
                "v1",
                "invitations",
                "{{followup_invitation_id}}",
                "revoke"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Session lifecycle and authenticated messaging",
      "description": "Log in, call protected messaging endpoints, log out, and verify the revoked session is rejected.",
      "item": [
        {
          "name": "01 - Login",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('auth_username', pm.environment.get('auth_username') || pm.environment.get('member_username') || pm.environment.get('bootstrap_admin_username'));",
                  "pm.environment.set('auth_password', pm.environment.get('auth_password') || pm.environment.get('member_password') || pm.environment.get('bootstrap_admin_password'));",
                  "pm.environment.set('flow_sender_user_id', pm.environment.get('flow_sender_user_id') || pm.environment.get('member_user_id') || pm.environment.get('admin_user_id'));",
                  "pm.environment.set('flow_conversation_id', 'session-flow-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('session_id', jsonData.sessionId);",
                  "pm.environment.set('session_token', jsonData.token);",
                  "pm.environment.set('auth_bearer_token', 'Bearer ' + jsonData.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{auth_username}}\",\n  \"password\": \"{{auth_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/sessions",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sessions"]
            }
          }
        },
        {
          "name": "02 - Send authenticated message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 501', function () {",
                  "  pm.response.to.have.status(501);",
                  "});",
                  "",
                  "pm.environment.set('message_id', jsonData.id || jsonData.messageId || '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{auth_bearer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{flow_conversation_id}}\",\n  \"senderUserId\": \"{{flow_sender_user_id}}\",\n  \"content\": \"Session flow message {{session_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/messages",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "messages"]
            }
          }
        },
        {
          "name": "03 - List authenticated messages",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 501', function () {",
                  "  pm.response.to.have.status(501);",
                  "});",
                  "",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{auth_bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/conversations/{{flow_conversation_id}}/messages?limit={{message_limit}}",
              "host": ["{{base_url}}"],
              "path": [
                "api",
                "v1",
                "conversations",
                "{{flow_conversation_id}}",
                "messages"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "{{message_limit}}"
                }
              ]
            }
          }
        },
        {
          "name": "04 - Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{auth_bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/sessions/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sessions", "logout"]
            }
          }
        },
        {
          "name": "05 - Verify revoked session denied",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{auth_bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/conversations/{{flow_conversation_id}}/messages?limit={{message_limit}}",
              "host": ["{{base_url}}"],
              "path": [
                "api",
                "v1",
                "conversations",
                "{{flow_conversation_id}}",
                "messages"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "{{message_limit}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Run-all API smoke journey",
      "description": "Single ordered workflow that covers onboarding, invitations, sessions, protected messaging, and post-logout authorization behavior.",
