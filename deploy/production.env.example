# Non-secret production settings. Copy outside the repository on the production host.
# Images must use immutable registry digests. Mutable tags are rejected by validation.
WL_CHAT_APP_IMAGE=docker.io/<owner>/wl-chat-production:app-<version>@sha256:<digest>
WL_CHAT_FLYWAY_IMAGE=docker.io/<owner>/wl-chat-production:migration-<version>@sha256:<digest>
WL_CHAT_SQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest@sha256:<reviewed-digest>
WL_CHAT_RABBITMQ_IMAGE=rabbitmq:4-management-alpine@sha256:<reviewed-digest>
WL_CHAT_NGINX_IMAGE=nginxinc/nginx-unprivileged:stable-alpine@sha256:<reviewed-digest>
WL_CHAT_CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest@sha256:<reviewed-digest>

WL_CHAT_PUBLIC_HOSTNAME=chat-api.wmkjsolutions.com
WL_CHAT_SQL_EDITION=Express
WL_CHAT_SQL_MEMORY_LIMIT_MB=2048
WL_CHAT_SQL_CPU_LIMIT=4
WL_CHAT_APP_MEMORY_LIMIT=768m
WL_CHAT_QUEUE_MEMORY_LIMIT=512m

# Absolute Windows-host paths expressed as WSL paths.
WL_CHAT_PRODUCTION_ROOT=/mnt/c/ProgramData/WLChat
WL_CHAT_SECRET_ROOT=/mnt/c/ProgramData/WLChat/secrets
WL_CHAT_EVIDENCE_ROOT=/mnt/c/ProgramData/WLChat/evidence
WL_CHAT_BACKUP_STAGING_ROOT=/mnt/c/ProgramData/WLChat/backup-staging
WL_CHAT_BACKUP_DESTINATION=/mnt/wl-chat-backups
WL_CHAT_BACKUP_MOUNT_SOURCE=//192.168.0.1/G
