# Copy to deploy/hardened.env, replace every secret, and keep the result untracked.

# Every infrastructure image must be pinned by digest after review.
WL_CHAT_SQL_IMAGE=mcr.microsoft.com/mssql/server:2022-CU26-ubuntu-22.04@sha256:replace
WL_CHAT_RABBITMQ_IMAGE=rabbitmq:4.3.4-management@sha256:replace
WL_CHAT_NGINX_IMAGE=nginxinc/nginx-unprivileged:stable-alpine@sha256:replace
WL_CHAT_FLYWAY_IMAGE=chat-backend-flyway@sha256:replace
WL_CHAT_APP_IMAGE=chat-backend@sha256:replace

WL_CHAT_DB_OPERATOR_USERNAME=sa
WL_CHAT_DB_OPERATOR_PASSWORD=replace
WL_CHAT_DB_USERNAME=wl_chat_app
WL_CHAT_DB_PASSWORD=replace
WL_CHAT_MIGRATOR_USERNAME=messenger_migrator
WL_CHAT_MIGRATOR_PASSWORD=replace
WL_CHAT_BACKUP_USERNAME=wl_chat_backup
WL_CHAT_BACKUP_PASSWORD=replace
WL_CHAT_RESTORE_USERNAME=wl_chat_restore
WL_CHAT_RESTORE_PASSWORD=replace
WL_CHAT_BACKUP_MASTER_KEY_PASSWORD=replace
WL_CHAT_BACKUP_CERTIFICATE_PASSWORD=replace

WL_CHAT_QUEUE_OPERATOR_USERNAME=wl_chat_queue_operator
WL_CHAT_QUEUE_OPERATOR_PASSWORD=replace
WL_CHAT_QUEUE_USERNAME=wl_chat_queue
WL_CHAT_QUEUE_PASSWORD=replace

WL_CHAT_SQL_TRUSTSTORE_PASSWORD=replace
WL_CHAT_WEBSOCKET_ALLOWED_ORIGINS=https://localhost
WL_CHAT_HTTP_BIND_ADDRESS=127.0.0.1
WL_CHAT_HTTPS_BIND_ADDRESS=127.0.0.1
