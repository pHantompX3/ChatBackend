quarkus.datasource.jdbc.url=jdbc:sqlserver://sqlserver:1433;databaseName=wl_chat;encrypt=true;trustServerCertificate=false;trustStore=/app/tls/sql-truststore.p12;trustStorePassword=<secret>
quarkus.datasource.username=wl_chat_app
quarkus.datasource.password=<secret>
chat.audit.rabbitmq.enabled=true
chat.audit.rabbitmq.host=queue
chat.audit.rabbitmq.port=5672
chat.audit.rabbitmq.username=wl_chat_queue
chat.audit.rabbitmq.password=<secret>
chat.audit.rabbitmq.vhost=/wl-chat
chat.audit.rabbitmq.exchange=audit.events
chat.audit.rabbitmq.routing-key=audit.completed
chat.audit.rabbitmq.queue=audit.events
chat.audit.rabbitmq.consumer.enabled=true
chat.audit.rabbitmq.provision-topology=false
chat.websocket.query-token-enabled=false
chat.websocket.origin-allowlist-required=true
chat.websocket.allowed-origins=https://<official-client-origin>
quarkus.flyway.migrate-at-start=false

