# Fixture mode is the safe X2-A default and requires no source credentials.
CHAT_MONITOR_DEPLOYMENT_MODE=native
CHAT_MONITOR_MODE=fixture
CHAT_MONITOR_HOST=127.0.0.1
CHAT_MONITOR_PORT=8090
CHAT_MONITOR_LOG_LEVEL=info
CHAT_MONITOR_FIXTURE_PATH=./test/fixtures/normalized-events.json
CHAT_MONITOR_SQLITE_PATH=./var/data/chat-monitor.sqlite
CHAT_MONITOR_POLL_INTERVAL_SECONDS=60
CHAT_MONITOR_PAGE_SIZE=500
CHAT_MONITOR_DETAIL_RETENTION_DAYS=90
CHAT_MONITOR_AGGREGATE_RETENTION_DAYS=365

# Preferred multi-environment registry. Leave blank for the legacy single-source variables below.
# Native example: ./environments/environments.json
# Docker example: /run/environments/environments.json
CHAT_MONITOR_ENVIRONMENTS_FILE=
CHAT_MONITOR_DEFAULT_ENVIRONMENT_ID=

# Legacy single-source compatibility. Required only when CHAT_MONITOR_MODE=sql and no registry file
# is configured. Never use VITE_ for server values.
CHAT_MONITOR_SOURCE_HOST=
CHAT_MONITOR_SOURCE_PORT=1433
CHAT_MONITOR_SOURCE_DATABASE=wl_chat
CHAT_MONITOR_SOURCE_USERNAME=wl_chat_monitor
CHAT_MONITOR_SOURCE_PASSWORD=
# Preferred for container deployments. Configure only one password input.
CHAT_MONITOR_SOURCE_PASSWORD_FILE=
CHAT_MONITOR_SOURCE_ENCRYPT=true
CHAT_MONITOR_SOURCE_TRUST_SERVER_CERTIFICATE=false
